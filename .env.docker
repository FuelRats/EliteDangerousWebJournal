# Example environment variables for docker-compose
# Copy this to .env and fill in your actual values

# Frontier API credentials (get these from https://auth.frontierstore.net/)
FRONTIER_CLIENT_ID=your_client_id_here
FRONTIER_CLIENT_SECRET=your_client_secret_here

# Session configuration (generate random strings)
SESSION_SECRET=your_long_random_session_secret_here_at_least_32_chars
COOKIE_SIGN_KEY=your_long_random_cookie_key_here_at_least_32_chars